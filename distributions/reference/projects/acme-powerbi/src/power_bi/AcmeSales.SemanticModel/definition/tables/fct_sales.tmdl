	measure 'Total Revenue' = SUM(fct_sales[total_revenue])
		formatString: "$"#,0.00;-"$"#,0.00;"$"#,0.00
		lineageTag: 9f8452f7-5c88-411e-bcfd-a57b756cbe9d

	measure 'Total Quantity' = SUM(fct_sales[total_quantity])
		formatString: #,0
