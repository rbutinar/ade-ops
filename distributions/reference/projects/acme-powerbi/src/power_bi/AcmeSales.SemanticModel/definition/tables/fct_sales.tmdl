	measure 'Transaction Count' = SUM(fct_sales[transaction_count])
		formatString: #,0
		lineageTag: 527dfe99-8123-4caf-825b-c1c02e0cacf5

	measure 'Avg Revenue per Transaction' = DIVIDE([Total Revenue], [Transaction Count])
		formatString: "$"#,0.00;-"$"#,0.00;"$"#,0.00
		lineageTag: 560023b8-d508-44e3-816a-e3531b7205ea

	measure 'Distinct Products Sold' = DISTINCTCOUNT(fct_sales[product_id])
