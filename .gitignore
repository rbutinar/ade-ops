# Credentials — NEVER commit
credentials.yaml
.env
.env.*

# Sanitization literal values — lab-only, consumed by /ops-publish engine.
# Public sibling core/conventions/sanitization-patterns.md is structural-only.
core/conventions/_private_sanitization_values.yaml

# MCP runtime config (paths + profile references — .mcp.example.json is committed)
.mcp.json

# Playwright MCP local browser profile + screenshot cache
.playwright-mcp/

# Project working data
_data/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/
venv*/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code sessions
.claude_sessions/

# Claude Code per-user settings (Anthropic convention: the .local.json
# suffix marks personal overrides — paths and permission rules vary by
# operator). The shared baseline lives in .claude/settings.json instead.
.claude/settings.local.json

# Logs
*.log

# Per-project personal scratch — never synced to remote envs
distributions/*/projects/*/local/

# Seat manifest — identifies the local clone + identities + roles; never committed.
# See core/conventions/seat.md for the schema and lifecycle.
distributions/*/.seat.yaml

# Onboarding sentinel — per-seat first-run marker (date + scenario). Local-only.
distributions/*/.ade-ops-onboarding-done

# Demo distribution: all state/ is single-user, gitignore wholesale
distributions/demo-claude/**/state/

# /ops-port-back marker (local-only: tracks lab/DevOps alignment SHA)
.claude/agents/ops-manager/last_port_back.yaml

# /marketing-manager — personal Roberto workspace (lab-only, never committed)
# Includes CONTEXT.md, IDENTITY.md, drafts/, drafts/img/, sources/, local/
# (REST wrappers + .cache/), session briefs, editorial plans.
.claude/agents/marketing-manager/

# Inter-agent consultation thread files — audit value medium, kept local
.claude/agents/_threads/
